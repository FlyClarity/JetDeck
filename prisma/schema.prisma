generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Operator {
  id               String   @id @default(cuid())
  clerkOrgId       String   @unique
  slug             String   @unique // used in intake URL: /intake/[slug]
  name             String
  logoUrl          String?
  wireInstructions String? // shown on confirmed booking
  termsText        String? // shown on client quote page (clickwrap)
  termsVersion     String? // hash of current terms, stored on acceptance
  notifyEmail      String? // internal notification address
  replyToEmail     String? // operator's charter inbox — Reply-To header on outbound quote emails, routes client replies back through triage
  fromEmail        String? // "From" address on outbound email — must be on a domain verified in Resend, else falls back to EMAIL_FROM
  depositPercent   Float    @default(0.25) // 25% card hold default
  inboundEmail     String? // e.g. requests-clarity@inbound.jetdeck.app

  // Quote Builder pricing defaults — editable per operator
  defaultBlockTimeBufferHours Float @default(0.2) // added per leg on top of raw distance/cruise-speed time (climb/descent/taxi)
  defaultOvernightFee         Float @default(1500) // $/night when the aircraft doesn't return to home base after the trip

  // Operator type controls which modules and UI are shown
  operatorType String @default("part135")
  // "part135" -- owns/manages aircraft, full platform
  // "broker"  -- no fleet, sources third-party aircraft only
  // "hybrid"  -- owns fleet AND brokers when unavailable (Clarity Aviation model)

  createdAt DateTime @default(now())

  aircraft           Aircraft[]
  contacts           Contact[]
  tripRequests       TripRequest[]
  quotes             Quote[]
  trips              Trip[]
  preferredOperators PreferredOperator[]
  inboundEmails      InboundEmail[]
}

model Contact {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  firstName  String
  lastName   String
  email      String
  phone      String?
  company    String?
  type       String // "direct" | "broker"
  notes      String?
  createdAt  DateTime @default(now())

  tripRequests TripRequest[]
  quotes       Quote[]
}

model Aircraft {
  id             String   @id @default(cuid())
  operatorId     String
  operator       Operator @relation(fields: [operatorId], references: [id])
  tailNumber     String
  make           String
  model          String
  category       String // "light" | "midsize" | "super_midsize" | "heavy" | "ultra_long"
  seats          Int
  homeBase       String // ICAO
  currentBase    String? // updated as trips complete (for positioning)
  hourlyRate     Float
  repoRate       Float? // if different from hourly (often discounted)
  minHoursPerDay Float    @default(2.0)
  hasWifi        Boolean  @default(false)
  rangeNm        Int?
  cruiseSpeedKts Float? // true cruise airspeed — manufacturer spec, entered once per aircraft; drives flight-time estimation
  status         String   @default("active")
  createdAt      DateTime @default(now())

  quotes Quote[]
}

// Reference data for flight-time/distance calculations. Empty until a real
// airport dataset (e.g. OurAirports/FAA) is imported — see BACKLOG.md.
model Airport {
  icao      String   @id
  iata      String?
  name      String
  lat       Float
  lon       Float
  elevation Int? // feet
  timezone  String? // IANA tz name, e.g. "America/New_York"
  city      String? // OurAirports "municipality"
  state     String? // OurAirports "iso_region", country prefix stripped (e.g. "CA", not "US-CA")
  createdAt DateTime @default(now())
}

model TripRequest {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])

  // Source
  source       String // "email_inbound" | "intake_form" | "manual"
  rawEmailBody String? // original email text (for email_inbound)
  rawEmailFrom String? // sender email address

  // Requestor info
  requestorName    String
  requestorEmail   String
  requestorPhone   String?
  requestorCompany String?
  requestorType    String // "direct" | "broker"

  // Trip details (AI-extracted or form-entered)
  tripType        String // "one_way" | "round_trip" | "multi_leg"
  legs            Json // [{ depAirport, arrAirport, date, timePref, timeFlexible, passengerCount }]
  aircraftPref    String?
  budgetMentioned Float?
  specialRequests String?
  urgency         String? // "asap" | "normal" | "flexible"

  // AI scoring
  opportunityScore  String? // "high" | "medium" | "low" | "pass"
  scoreReason       String?
  positioningNote   String?
  historyNote       String?
  recommendedAction String? // "quote_now" | "review" | "pass"
  aiProcessedAt     DateTime?

  // AI price suggestion shown on /quotes/new — computed once and cached
  // here so reloading/revisiting that page doesn't re-bill the AI call.
  aiPriceSuggestion Float?

  status String @default("new")
  // "new" | "scoring" | "ready" | "quoted" | "passed" | "closed"

  createdAt DateTime @default(now())
  quotes    Quote[]
}

model Quote {
  id            String       @id @default(cuid())
  operatorId    String
  operator      Operator     @relation(fields: [operatorId], references: [id])
  quoteNumber   String // "Q-2024-0042"
  tripRequestId String?
  tripRequest   TripRequest? @relation(fields: [tripRequestId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])
  aircraftId    String?
  aircraft      Aircraft?    @relation(fields: [aircraftId], references: [id])

  // Own fleet vs brokered
  fleetSource String @default("own_fleet")
  // "own_fleet" -- aircraft from operator's own managed fleet
  // "brokered"  -- third-party aircraft sourced for this trip
  brokeredAircraftId String?
  brokeredAircraft   BrokeredAircraft? @relation(fields: [brokeredAircraftId], references: [id])

  // Itinerary
  itinerary Json // [{ depAirport, arrAirport, depDt, arrDt, flightHours }]

  // Pricing
  flightHours    Float
  hourlyRate     Float
  repoHours      Float   @default(0)
  repoRate       Float   @default(0)
  returnsToHomeBase Boolean @default(true) // if false, overnightFee applies instead of a return repositioning leg
  overnightNights   Int     @default(0)
  overnightFee      Float   @default(0) // computed: overnightNights * operator.defaultOvernightFee at time of quote
  landingFees    Float   @default(0)
  handlingFees   Float   @default(0)
  additionalFees Json    @default("[]") // [{ label, amount }]
  fetTax         Float   @default(0)
  discount       Float   @default(0)
  discountNote   String?
  subtotal       Float
  total          Float
  depositAmount  Float? // calculated from total * operator.depositPercent

  // Brokered trip cost tracking (only populated when fleetSource = "brokered")
  wholesaleCost Float? // what operator pays the third-party operator
  brokerMargin  Float? // total - wholesaleCost (calculated, stored for reporting)

  // AI pricing recommendation
  aiPriceSuggestion Float?
  aiPriceReasoning  String?

  internalNotes String?
  validUntil    DateTime

  // Non-revenue trips created directly (bypassing the client quoting
  // pipeline entirely) — owner flights, maintenance ferries, etc. Null for
  // every normal client-facing quote.
  tripPurpose String? // "owner" | "maintenance" | "repositioning" | "other"

  // Client-facing
  token  String @unique @default(cuid())
  status String @default("draft")
  // "draft" | "sent" | "pending_confirmation" | "accepted" | "declined" | "expired" | "converted" | "cancelled"
  // pending_confirmation: client legally accepted (terms/IP/timestamp
  // recorded) but a same-aircraft/date conflict was found, so nothing else
  // (Trip, Stripe hold, confirmation email) fires until the operator
  // resolves it — see lib/booking-server.ts

  sentAt DateTime?

  // Legal acceptance record
  acceptedAt        DateTime?
  acceptedByName    String? // name the client typed to confirm they read the terms
  acceptedIp        String?
  acceptedUserAgent String?
  acceptedTermsHash String? // hash of exact terms shown at acceptance

  declinedAt DateTime?

  // Set when accepting this quote finds another accepted quote on the same
  // aircraft with overlapping dates — surfaced to the operator so they can
  // resolve the conflict manually (e.g. cancel one of the two bookings).
  conflictWarning String?

  // Set when the operator cancels an already-accepted booking (aircraft/crew
  // no longer available, etc.)
  cancelledAt     DateTime?
  cancellationNote String?

  // Stripe
  stripePaymentIntentId String?
  cardHoldStatus        String? // "pending" | "authorized" | "released" | "captured"

  createdBy String // Clerk user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip?
}

model Trip {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  tripNumber String // "T-2024-0018"
  quoteId    String   @unique
  quote      Quote    @relation(fields: [quoteId], references: [id])

  status String @default("confirmed")
  // "confirmed" | "awaiting_payment" | "ops_review" | "crew_assigned"
  // | "pre_flight" | "in_flight" | "completed" | "invoiced" | "closed"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Trusted third-party operators — the operator's sourcing network
model PreferredOperator {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])

  name         String // Company name, e.g. "East Coast Jets"
  contactName  String?
  contactEmail String
  contactPhone String?
  notes        String? // e.g. "Great King Airs, reliable, responds fast"
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())

  brokeredAircraft BrokeredAircraft[]
}

// A specific tail sourced from a preferred operator for a brokered trip
model BrokeredAircraft {
  id                  String            @id @default(cuid())
  operatorId          String // the JetDeck tenant doing the brokering
  preferredOperatorId String
  preferredOperator   PreferredOperator @relation(fields: [preferredOperatorId], references: [id])

  tailNumber String
  make       String?
  model      String?
  category   String? // "light" | "midsize" | etc.
  seats      Int?
  homeBase   String?

  createdAt DateTime @default(now())

  quotes Quote[]
}

model InboundEmail {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  // Postmark's own message id for this delivery — used to dedupe webhook
  // retries so a slow response doesn't cause the same email to be
  // reprocessed (and re-billed to the AI) multiple times.
  postmarkMessageId String? @unique

  // Raw email data from Postmark
  fromEmail    String
  fromName     String?
  // Distinct from fromEmail — feeds like NBAA relay mail through a shared
  // sender address (e.g. "Charter Airmail") but set Reply-To to the real
  // client/broker. Treated as the effective contact email when present.
  replyToEmail String?
  toEmail      String
  subject      String?
  bodyText     String
  bodyHtml     String?
  receivedAt   DateTime

  // AI triage result
  classification           String
  classificationConfidence String? // "high" | "medium" | "low"
  classificationReason     String?
  aiProcessedAt            DateTime?

  // Action taken
  status String @default("processing")
  // "processing" | "trip_request_created" | "attached_to_quote"
  // | "logged_as_inquiry" | "discarded" | "needs_review" | "manually_resolved"

  // Links to what was created/matched
  tripRequestId String?
  quoteId       String?

  // Human correction if AI misclassified
  reviewedBy      String? // Clerk user ID
  reviewedAt      DateTime?
  correctedAction String?

  createdAt DateTime @default(now())
}
