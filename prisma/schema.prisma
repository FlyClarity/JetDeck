generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Operator {
  id               String   @id @default(cuid())
  clerkOrgId       String   @unique
  slug             String   @unique // used in intake URL: /intake/[slug]
  name             String
  logoUrl          String?
  wireInstructions String? // shown on confirmed booking
  termsText        String? // shown on client quote page (clickwrap)
  termsVersion     String? // hash of current terms, stored on acceptance
  notifyEmail      String? // internal notification address
  replyToEmail     String? // operator's charter inbox — Reply-To header on outbound quote emails, routes client replies back through triage
  fromEmail        String? // "From" address on outbound email — must be on a domain verified in Resend, else falls back to EMAIL_FROM
  depositPercent   Float    @default(0.25) // 25% card hold default
  inboundEmail     String? // e.g. requests-clarity@inbound.jetdeck.app

  // Stripe Connect — each operator has their own connected Express
  // account (Stripe-hosted onboarding), so client card holds route
  // directly to the operator's own account rather than JetDeck's
  // platform account. stripeChargesEnabled mirrors Stripe's own
  // account.charges_enabled flag (updated via the account.updated
  // webhook) — onboarding can be started (stripeAccountId set) without
  // being complete, so this is what actually gates whether a checkout
  // session can be created for this operator.
  stripeAccountId      String?
  stripeChargesEnabled Boolean @default(false)
  // % surcharge added to the deposit when a client pays by credit card
  // instead of wire — offsets card processing costs. 0 disables it.
  ccProcessingFeePercent Float @default(3.0)

  // Quote Builder pricing defaults — editable per operator
  defaultBlockTimeBufferHours Float @default(0.2) // added per leg on top of raw distance/cruise-speed time (climb/descent/taxi)
  defaultOvernightFee         Float @default(1500) // $/night when the aircraft doesn't return to home base after the trip

  // Operator type controls which modules and UI are shown
  operatorType String @default("part135")
  // "part135" -- owns/manages aircraft, full platform
  // "broker"  -- no fleet, sources third-party aircraft only
  // "hybrid"  -- owns fleet AND brokers when unavailable (Clarity Aviation model)

  createdAt DateTime @default(now())

  aircraft           Aircraft[]
  contacts           Contact[]
  tripRequests       TripRequest[]
  quotes             Quote[]
  trips              Trip[]
  preferredOperators PreferredOperator[]
  inboundEmails      InboundEmail[]
  crewMembers        CrewMember[]
}

model Contact {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  firstName  String
  lastName   String
  email      String
  phone      String?
  company    String?
  type       String // "direct" | "broker"
  notes      String?

  // "standard" -- normal card-hold-on-acceptance flow
  // "cash_on_account" -- trusted/invoiced client; skip the card hold
  // requirement entirely at booking time (finalizeBooking treats it like
  // no deposit is due)
  paymentTerms String @default("standard")

  createdAt  DateTime @default(now())

  tripRequests TripRequest[]
  quotes       Quote[]
}

model Aircraft {
  id             String   @id @default(cuid())
  operatorId     String
  operator       Operator @relation(fields: [operatorId], references: [id])
  tailNumber     String
  make           String
  model          String
  category       String // "light" | "midsize" | "super_midsize" | "heavy" | "ultra_long"
  seats          Int
  homeBase       String // ICAO
  currentBase    String? // updated as trips complete (for positioning)
  hourlyRate     Float
  repoRate       Float? // if different from hourly (often discounted)
  minHoursPerDay Float    @default(2.0)
  rangeNm        Int?
  cruiseSpeedKts Float? // true cruise airspeed — manufacturer spec, entered once per aircraft; drives flight-time estimation
  status         String   @default("active")
  createdAt      DateTime @default(now())

  // Photo gallery (Vercel Blob URLs, public access) and a flexible amenity
  // list (see AIRCRAFT_AMENITIES in lib/aircraft.ts) — replaces the old
  // single hasWifi boolean, which didn't scale to "what's actually on this
  // plane" for the client quote page. Managed in the Fleet section, shown
  // to the client on /q/[token].
  photos    String[] @default([])
  amenities String[] @default([])

  quoteOptions QuoteOption[]
}

// Reference data for flight-time/distance calculations. Empty until a real
// airport dataset (e.g. OurAirports/FAA) is imported — see BACKLOG.md.
model Airport {
  icao      String   @id
  iata      String?
  name      String
  lat       Float
  lon       Float
  elevation Int? // feet
  timezone  String? // IANA tz name, e.g. "America/New_York"
  city      String? // OurAirports "municipality"
  state     String? // OurAirports "iso_region", country prefix stripped (e.g. "CA", not "US-CA")
  createdAt DateTime @default(now())
}

model TripRequest {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  contactId  String?
  contact    Contact? @relation(fields: [contactId], references: [id])

  // Source
  source       String // "email_inbound" | "intake_form" | "manual"
  rawEmailBody String? // original email text (for email_inbound)
  rawEmailFrom String? // sender email address

  // Requestor info
  requestorName    String
  requestorEmail   String
  requestorPhone   String?
  requestorCompany String?
  requestorType    String // "direct" | "broker"

  // Trip details (AI-extracted or form-entered)
  tripType        String // "one_way" | "round_trip" | "multi_leg"
  legs            Json // [{ depAirport, arrAirport, date, timePref, timeFlexible, passengerCount }]
  aircraftPref    String?
  budgetMentioned Float?
  specialRequests String?
  urgency         String? // "asap" | "normal" | "flexible"

  // AI scoring
  opportunityScore  String? // "high" | "medium" | "low" | "pass"
  scoreReason       String?
  positioningNote   String?
  historyNote       String?
  recommendedAction String? // "quote_now" | "review" | "pass"
  aiProcessedAt     DateTime?

  // AI price suggestion shown on /quotes/new — computed once and cached
  // here so reloading/revisiting that page doesn't re-bill the AI call.
  aiPriceSuggestion Float?

  status String @default("new")
  // "new" | "scoring" | "ready" | "quoted" | "passed" | "expired" | "closed"
  // "expired" is set by a daily cron sweep (lib/expire-stale.ts) for
  // requests still sitting in "new"/"ready" — never even quoted — whose
  // last requested leg date has passed with no action taken.

  createdAt DateTime @default(now())
  quotes    Quote[]
}

model Quote {
  id            String       @id @default(cuid())
  operatorId    String
  operator      Operator     @relation(fields: [operatorId], references: [id])
  quoteNumber   String // "Q-2024-0042"
  tripRequestId String?
  tripRequest   TripRequest? @relation(fields: [tripRequestId], references: [id])
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id])

  // "Options" — one quote can hold multiple priced itinerary variations
  // (e.g. same trip from a different departure airport, or a different
  // aircraft) that the client chooses between. Every quote has at least
  // one QuoteOption; selectedOptionId points at whichever one is "active"
  // for booking purposes — the sole option for a legacy single-option
  // quote, or whichever one the client picked once there's more than one.
  // Everything downstream that used to read pricing/itinerary/aircraft
  // straight off Quote (booking, Stripe, conflict-checking, the client
  // page) now reads it off quote.selectedOption instead.
  options          QuoteOption[] @relation("QuoteOptions")
  selectedOptionId String?
  selectedOption   QuoteOption?  @relation("SelectedOption", fields: [selectedOptionId], references: [id])

  internalNotes String? // operator-only, never shown to the client — shared across all options, not option-specific
  validUntil    DateTime

  // Snapshotted from Operator.termsText the moment the quote is sent (see
  // sendQuote in app/(app)/quotes/[id]/page.tsx) — the client-facing page
  // and acceptedTermsHash both read this instead of the live, editable
  // Operator.termsText, so an operator editing their charter terms in
  // Settings after a quote goes out can't retroactively change what a
  // given quote's client is shown or what they're recorded as having
  // agreed to. Null for quotes sent before this field existed; those fall
  // back to the live Operator.termsText, same as always.
  termsTextSnapshot String?

  // Non-revenue trips created directly (bypassing the client quoting
  // pipeline entirely) — owner flights, maintenance ferries, etc. Null for
  // every normal client-facing quote.
  tripPurpose String? // "owner" | "maintenance" | "repositioning" | "other"

  // Client-facing
  token  String @unique @default(cuid())
  status String @default("draft")
  // "draft" | "sent" | "pending_confirmation" | "approved" | "accepted"
  // | "declined" | "expired" | "converted" | "cancelled"
  // "expired" is set two ways: computed live on /q/[token] from validUntil
  // (the pricing offer's own shelf life) without ever being stored, or set
  // for real by the daily cron sweep (lib/expire-stale.ts) for a
  // draft/sent/pending_confirmation/approved quote whose selected option's
  // last leg date has passed with no acceptance — a different trigger
  // (the flight date, not the quote's validity window) than the live check.
  // Two-step booking: client clicks "Request to Book" (non-binding, no
  // terms/signature yet) -> pending_confirmation, requestedAt set. Operator
  // reviews (same-aircraft conflict check runs automatically as advisory
  // context) and either declines, or confirms -> approved, approvedAt set,
  // client emailed to come finalize. Only then does the client see the
  // legal "I Accept — Book This Charter" terms/signature step -> accepted
  // (via finalizeBooking: Trip, Stripe hold, confirmation email). A fresh
  // conflict check re-runs at that final signature too, as a safety net for
  // the rare case something else got booked in between operator approval
  // and client signature — if one turns up, it drops back to
  // pending_confirmation instead of finalizing. See lib/booking-server.ts.

  sentAt      DateTime?
  requestedAt DateTime? // client clicked "Request to Book"
  approvedAt  DateTime? // operator confirmed availability

  // Legal acceptance record — set only at the final "I Accept" signature
  // step (status approved -> accepted), not at the earlier non-binding
  // "Request to Book" click.
  acceptedAt        DateTime?
  acceptedByName    String? // name the client typed to confirm they read the terms
  acceptedIp        String?
  acceptedUserAgent String?
  acceptedTermsHash String? // hash of exact terms shown at acceptance

  declinedAt DateTime?

  // Set when requesting to book (or, on the rare re-check, finalizing) finds
  // another accepted/pending quote on the same aircraft with overlapping
  // dates — surfaced to the operator as advisory context for their
  // availability decision, not a hard gate (the review step is now
  // unconditional either way).
  conflictWarning String?

  // Set when the operator cancels an already-accepted booking (aircraft/crew
  // no longer available, etc.)
  cancelledAt     DateTime?
  cancellationNote String?

  // Payment method — chosen by the client at the signature step, alongside
  // acceptedAt/acceptedByName. Independent of cardHoldStatus: a card hold is
  // authorized either way (unless the linked Contact is cash-on-account,
  // which skips Stripe entirely) — "wire" just means the hold is a backup
  // rather than how the flight actually gets paid for. See finalizeBooking
  // and markWireReceived in lib/booking-server.ts.
  paymentMethod String? // "wire" | "credit_card"

  // The actual dollar amount held via Stripe — equals the option's
  // depositAmount for a wire payer, or depositAmount plus the operator's
  // ccProcessingFeePercent surcharge for a credit-card payer (the fee only
  // ever applies when the card itself is how the flight gets paid for).
  // Null until a hold is actually created (no hold at all for cash-on-
  // account). Snapshotted here rather than recomputed later so it stays
  // accurate even if the operator changes ccProcessingFeePercent afterward.
  cardHoldAmount Float?

  // Set by the operator (Mark Wire Received, on the quote detail page) once
  // an actual wire payment shows up — the trigger that flips the linked
  // Trip to "confirmed" and releases the backup card hold, since it's no
  // longer needed. Stays null for a credit-card payer (their card hold IS
  // the payment) and for cash-on-account (no hold to release).
  wireConfirmedAt DateTime?

  // Stripe
  stripePaymentIntentId String?
  cardHoldStatus        String? // "pending" | "authorized" | "released" | "captured"

  // Set once the client-facing "you're confirmed" email actually goes out —
  // guards against double-sending, since when a deposit is due that email
  // now fires from the checkout.session.completed webhook (see
  // sendBookingConfirmationEmail in lib/booking-server.ts), and Stripe
  // webhooks can redeliver the same event.
  confirmationEmailSentAt DateTime?

  createdBy String // Clerk user ID
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip?
}

// A single priced itinerary variation on a Quote. Most quotes have exactly
// one (created alongside the Quote itself); "Options" lets an operator add
// more (e.g. same trip from a more efficient departure airport, or a
// different aircraft) so the client can compare and pick. Quote.
// selectedOptionId points at whichever one is currently "active" — see the
// comment on Quote.options.
model QuoteOption {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation("QuoteOptions", fields: [quoteId], references: [id], onDelete: Cascade)

  // Shown to the client when a quote has more than one option (e.g.
  // "Option A"); irrelevant/hidden for the common single-option case.
  label     String @default("Option A")
  sortOrder Int    @default(0)

  aircraftId String?
  aircraft   Aircraft? @relation(fields: [aircraftId], references: [id])

  // Own fleet vs brokered
  fleetSource String @default("own_fleet")
  // "own_fleet" -- aircraft from operator's own managed fleet
  // "brokered"  -- third-party aircraft sourced for this trip
  brokeredAircraftId String?
  brokeredAircraft   BrokeredAircraft? @relation(fields: [brokeredAircraftId], references: [id])

  // Itinerary
  itinerary Json // [{ depAirport, arrAirport, depDt, arrDt, flightHours }]

  // Pricing
  flightHours       Float
  hourlyRate        Float
  repoHours         Float   @default(0)
  repoRate          Float   @default(0)
  returnsToHomeBase Boolean @default(true) // if false, overnightFee applies instead of a return repositioning leg
  overnightNights   Int     @default(0)
  overnightFee      Float   @default(0) // computed: overnightNights * operator.defaultOvernightFee at time of quote
  landingFees       Float   @default(0)
  handlingFees      Float   @default(0)
  additionalFees    Json    @default("[]") // [{ label, amount }]
  fetTax            Float   @default(0)
  discount          Float   @default(0)
  discountNote      String?
  subtotal          Float
  total             Float
  depositAmount     Float? // calculated from total * operator.depositPercent

  // Brokered trip cost tracking (only populated when fleetSource = "brokered")
  wholesaleCost Float? // what operator pays the third-party operator
  brokerMargin  Float? // total - wholesaleCost (calculated, stored for reporting)

  // AI pricing recommendation
  aiPriceSuggestion Float?
  aiPriceReasoning  String?

  // Shown on the client-facing quote page (/q/[token]) for this specific
  // option — e.g. catering, ground transport, aircraft-specific notes.
  // Distinct from Quote.internalNotes, which is operator-only and shared
  // across all options on the quote.
  clientNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  selectedForQuote Quote[] @relation("SelectedOption")
}

model Trip {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])
  tripNumber String // "T-2024-0018"
  quoteId    String   @unique
  quote      Quote    @relation(fields: [quoteId], references: [id])

  status String @default("confirmed")
  // "confirmed" | "awaiting_payment" | "ops_review" | "crew_assigned"
  // | "pre_flight" | "in_flight" | "completed" | "invoiced" | "closed"
  // | "cancelled_by_operator" (cascaded from Quote.status when an operator
  // cancels an already-accepted booking — "cancelled_by_client" and
  // "cancelled_weather" are reserved for when those flows exist, nothing
  // sets them yet) | "manifest_pending" | "manifest_complete" | "released"
  // (reserved — the Ops Build Brief's proposed flow, not wired to any
  // transition yet; "crew_assigned" is the only one of this group actually
  // set today, by assignCrew in ops/trips/[id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passengers        Passenger[]
  manifestReminders ManifestReminder[]
  crewAssignments   TripCrewAssignment[]
}

// One row per passenger on a Trip, including the lead passenger. Every
// passenger — lead or additional — gets their own unique token so the lead
// can forward an individual link rather than sharing their own; isLead
// just controls which capabilities the /manifest/[token] page exposes for
// that row (the lead can add/see the whole trip's roster, others can only
// see and edit themselves).
model Passenger {
  id         String @id @default(cuid())
  operatorId String
  tripId     String
  trip       Trip   @relation(fields: [tripId], references: [id])
  token      String @unique @default(cuid())

  // Identity
  firstName   String?
  lastName    String?
  dateOfBirth DateTime?
  weightLbs   Int?

  // ID
  idType   String? // "passport" | "drivers_license" | "government_id"
  idNumber String?
  idExpiry DateTime?
  idImageUrl String? // uploaded to Vercel Blob, same pattern as Aircraft.photos

  // Optional
  ktn             String? // known traveler number / TSA PreCheck
  specialRequests String?

  // Status
  isLead      Boolean   @default(false)
  submittedAt DateTime?
  verifiedAt  DateTime?
  verifiedBy  String? // Clerk user ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tracks which reminder thresholds have already fired for a trip, so the
// cron sweep (lib/manifest.ts) never sends the same one twice. One row per
// threshold, created lazily by the sweep itself the first time it applies
// (not pre-created when the trip is booked), since which thresholds even
// make sense depends on how much runway there is before departure.
model ManifestReminder {
  id         String    @id @default(cuid())
  operatorId String
  tripId     String
  trip       Trip      @relation(fields: [tripId], references: [id])
  type       String // "72hr" | "48hr" | "24hr" | "12hr"
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([tripId, type])
}

// The operator's pilots/crew. Deliberately minimal — the brief explicitly
// defers full duty-time/currency tracking, type ratings, and a scheduling
// calendar as their own later modules; this is just enough to assign a
// name to a trip.
model CrewMember {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  name  String
  role  String // "captain" | "first_officer" | "flight_attendant" | "other"
  email String?
  phone String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments TripCrewAssignment[]
}

// roleOnTrip snapshots CrewMember.role at assignment time rather than
// always reading the live role — someone's normal role can change (or
// they could crew a trip in a different seat than usual) without rewriting
// history on trips they already flew.
model TripCrewAssignment {
  id         String     @id @default(cuid())
  operatorId String
  tripId     String
  trip       Trip       @relation(fields: [tripId], references: [id])
  crewId     String
  crew       CrewMember @relation(fields: [crewId], references: [id])
  roleOnTrip String

  createdAt DateTime @default(now())

  @@unique([tripId, crewId])
}

// Trusted third-party operators — the operator's sourcing network
model PreferredOperator {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id])

  name         String // Company name, e.g. "East Coast Jets"
  contactName  String?
  contactEmail String
  contactPhone String?
  notes        String? // e.g. "Great King Airs, reliable, responds fast"
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())

  brokeredAircraft BrokeredAircraft[]
}

// A specific tail sourced from a preferred operator for a brokered trip
model BrokeredAircraft {
  id                  String            @id @default(cuid())
  operatorId          String // the JetDeck tenant doing the brokering
  preferredOperatorId String
  preferredOperator   PreferredOperator @relation(fields: [preferredOperatorId], references: [id])

  tailNumber String
  make       String?
  model      String?
  category   String? // "light" | "midsize" | etc.
  seats      Int?
  homeBase   String?

  createdAt DateTime @default(now())

  quoteOptions QuoteOption[]
}

model InboundEmail {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id])

  // Postmark's own message id for this delivery — used to dedupe webhook
  // retries so a slow response doesn't cause the same email to be
  // reprocessed (and re-billed to the AI) multiple times.
  postmarkMessageId String? @unique

  // Raw email data from Postmark
  fromEmail    String
  fromName     String?
  // Distinct from fromEmail — feeds like NBAA relay mail through a shared
  // sender address (e.g. "Charter Airmail") but set Reply-To to the real
  // client/broker. Treated as the effective contact email when present.
  replyToEmail String?
  toEmail      String
  subject      String?
  bodyText     String
  bodyHtml     String?
  receivedAt   DateTime

  // AI triage result
  classification           String
  classificationConfidence String? // "high" | "medium" | "low"
  classificationReason     String?
  aiProcessedAt            DateTime?

  // Action taken
  status String @default("processing")
  // "processing" | "trip_request_created" | "attached_to_quote"
  // | "logged_as_inquiry" | "discarded" | "needs_review" | "manually_resolved"

  // Links to what was created/matched
  tripRequestId String?
  quoteId       String?

  // Human correction if AI misclassified
  reviewedBy      String? // Clerk user ID
  reviewedAt      DateTime?
  correctedAction String?

  createdAt DateTime @default(now())
}
